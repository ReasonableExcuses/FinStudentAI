# Database (SQLite default fallback, or PostgreSQL)
DATABASE_URL=sqlite:///./finstudent.db
# DATABASE_URL=postgresql://finstudent:finstudent_password@localhost:5432/finstudent_db

# Security & JWT
SECRET_KEY=finstudent_super_secret_jwt_key_2026_idp_secure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Machine Learning & AI Fallback Mode
# Set to true for 100% self-contained local AI execution (No external API keys required!)
FALLBACK_MODE=true

# Optional: External LLM Key (Not required for demo)
# OPENAI_API_KEY=your_key_here

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000/api
